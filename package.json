{
  "name": "protein-notes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @protein/web",
    "build": "npm run build -w @protein/web",
    "preview": "npm run preview -w @protein/web",
    "studio": "npm run start -w @protein/studio",
    "fetch": "node packages/pipeline/ingest.mjs",
    "triage": "node packages/pipeline/triage.mjs",
    "draft": "node packages/pipeline/draft.mjs",
    "new": "node packages/pipeline/new.mjs",
    "validate": "node packages/pipeline/validate.mjs",
    "check:cites": "node packages/pipeline/check-citations.mjs",
    "check": "npm run check:cites && npm run validate"
  }
}
