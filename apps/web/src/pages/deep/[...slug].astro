---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Deep from '../../layouts/Deep.astro';

export async function getStaticPaths() {
  const all = await getCollection('deep', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const sorted = all.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[i - 1] as CollectionEntry<'deep'> | undefined,
      next: sorted[i + 1] as CollectionEntry<'deep'> | undefined,
      no: i + 1,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'deep'>;
  prev?: CollectionEntry<'deep'>;
  next?: CollectionEntry<'deep'>;
  no: number;
}
const { entry, prev, next, no } = Astro.props;
const { Content, headings } = await render(entry);
---
<Deep entry={entry} Content={Content} headings={headings} prev={prev} next={next} no={no} />
