---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { NODES, EDGES } from '../lib/atlas';
import { url } from '../lib/url';
import { fmtDate, readingTime } from '../lib/format';

const live = ({ data }: any) => (import.meta.env.PROD ? !data.draft : true);
const weekly = (await getCollection('weekly', live)).sort((a, b) => b.data.issue - a.data.issue);
const deep = (await getCollection('deep', live)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = weekly[0];
---
<Base>
  <div class="wrap">
    <section class="home-hero">
      <div>
        <p class="kicker">AI 蛋白质设计 / 研究手记</p>
        <h1>折叠之后</h1>
        <p class="home-hero__lede">
          每周五一份周报，五到六条值得读的进展；不定期一篇深度，把一条路线拆到可以动手；
          一张持续生长的知识树，用来回答「这个领域到底做了什么」。
        </p>
        <div class="home-hero__actions">
          <a class="btn" href={url('/weekly/')}>读最新周报</a>
          <a class="btn btn--ghost" href={url('/deep/')}>浏览深度</a>
        </div>
      </div>
      {latest && (
        <aside class="home-hero__aside">
          <a class="latest-card" href={url(`/weekly/${latest.id}/`)}>
            <span class="latest-card__week">WEEK {latest.data.week} · {latest.data.items.length} 条</span>
            <h2>{latest.data.title}</h2>
            <p>{latest.data.summary}</p>
            <span class="latest-card__meta">{fmtDate(latest.data.date, 'short')} · 读这一期 →</span>
          </a>
        </aside>
      )}
    </section>

    <div class="home-body">
      <section>
        <div class="section-head">
          <h2>深度</h2>
          <a href={url('/deep/')}>全部 →</a>
        </div>
        {deep.slice(0, 4).map((n, i) => (
          <a class="list-note" href={url(`/deep/${n.id}/`)}>
            <span class="list-note__no">{String(deep.length - i).padStart(2, '0')}</span>
            <span>
              <span class="list-note__title">{n.data.title}</span>
              <span class="list-note__desc">{n.data.summary}</span>
            </span>
            <span class="list-note__date">{readingTime(n.body ?? '')} min</span>
          </a>
        ))}
      </section>

      <aside>
        <a class="tree-card" href={url('/tree/')}>
          <span class="kicker">知识树</span>
          <div class="tree-card__num">{NODES.length}</div>
          <p>个词条 · {EDGES.length} 条关系</p>
          <h2>从结构预测到实验账本</h2>
          <p>两条学习路线，每个词条都能继续下钻；先看地图，再按概念走。</p>
          <span class="tree-card__cta">进入知识树</span>
        </a>
      </aside>
    </div>
  </div>
</Base>
