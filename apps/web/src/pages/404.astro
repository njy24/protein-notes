---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="页面不存在" noindex>
  <div class="wrap" style="padding:clamp(4rem,10vw,8rem) 0">
    <p class="kicker kicker--accent">404 / Not found</p>
    <h1 class="display" style="margin:1rem 0 1.2rem">这一页<br />没有折叠好。</h1>
    <p class="lede">链接可能来自旧版本，或者这篇文章还没写出来。</p>
    <div style="display:flex;gap:.7rem;margin-top:2rem;flex-wrap:wrap">
      <a class="btn" href={url('/')}>回到首页</a>
      <a class="btn btn--ghost" href={url('/weekly/')}>看周报</a>
    </div>
  </div>
</Base>
