---
import { SITE, NAV } from '../config/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <div style="display:flex;align-items:baseline;gap:.5rem">
          <span style="font-family:var(--display-font);font-size:1.05rem;color:var(--ink);font-weight:600">
            {SITE.name}
          </span>
          <span class="mono" style="font-size:.62rem;letter-spacing:.16em;color:var(--faint)">
            {SITE.nameEn.toUpperCase()}
          </span>
        </div>
        <p style="margin-top:.6rem;max-width:34em;line-height:1.75">
          一个服务于两个蛋白质课题的公开信息工作流：追踪进展、拆解方法、核验证据，并记录从读到做的过程。
        </p>
        <p class="mono" style="margin-top:.8rem;font-size:.64rem;letter-spacing:.08em;color:var(--faint)">
          SINCE {SITE.since} · {SITE.license}
        </p>
      </div>

      <div>
        <h3>内容</h3>
        <ul>
          {NAV.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h3>订阅与说明</h3>
        <ul>
          <li><a href={url(SITE.rssPath)}>RSS 订阅</a></li>
          <li><a href={url('/method/')}>编辑流程与质量门</a></li>
          <li><a href={url('/about/')}>关于本站</a></li>
          {SITE.repoUrl && (
            <li>
              <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer">源码仓库 ↗</a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {SITE.name}</span>
      <span>{SITE.tagline}</span>
      <span>静态构建 · 无追踪脚本</span>
    </div>
  </div>
</footer>
