---
import { url } from '../lib/url';
---
<dialog id="search-dialog" class="search-dialog" data-index={url('/search.json')} aria-label="站内搜索">
  <div class="search-dialog__inner">
    <form method="dialog" style="display:flex;justify-content:flex-end">
      <button class="icon-btn" aria-label="关闭搜索" title="关闭 (Esc)">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>
    <label class="mono" for="search-input" style="font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)">
      搜索 / Search
    </label>
    <input id="search-input" type="search" placeholder="标题、标签、摘要…" autocomplete="off" spellcheck="false" />
    <ul class="search-results"></ul>
    <p class="search-empty">输入关键词开始 · Esc 关闭</p>
  </div>
</dialog>

<script>
  type Entry = { title: string; url: string; summary: string; type: string; tags: string[]; date: string };
  const dlg = document.querySelector<HTMLDialogElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const list = document.querySelector<HTMLUListElement>('.search-results');
  const empty = document.querySelector<HTMLParagraphElement>('.search-empty');
  let index: Entry[] | null = null;

  async function ensure(): Promise<Entry[]> {
    if (index) return index;
    try {
      const res = await fetch(dlg!.dataset.index!);
      index = (await res.json()) as Entry[];
    } catch {
      index = [];
    }
    return index;
  }

  function render(q: string) {
    if (!list || !empty) return;
    const query = q.trim().toLowerCase();
    list.innerHTML = '';
    if (!query) {
      empty.textContent = '输入关键词开始 · Esc 关闭';
      empty.hidden = false;
      return;
    }
    const data = index ?? [];
    const hits = data
      .map((e) => {
        const t = e.title.toLowerCase();
        const s = (e.summary + ' ' + e.tags.join(' ')).toLowerCase();
        let score = 0;
        if (t.startsWith(query)) score += 100;
        if (t.includes(query)) score += 50;
        if (e.tags.some((x) => x.toLowerCase().includes(query))) score += 20;
        if (s.includes(query)) score += 10;
        return { e, score };
      })
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 12);

    empty.hidden = hits.length > 0;
    empty.textContent = '没有找到匹配内容。试试「binder」「扩散」「实验」等更宽的关键词。';
    for (const { e } of hits) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = e.url;
      const b = document.createElement('b');
      b.textContent = e.title;
      const span = document.createElement('span');
      span.textContent = `${e.type}${e.date ? ' · ' + e.date : ''} — ${e.summary}`;
      a.append(b, span);
      li.append(a);
      list.append(li);
    }
  }

  async function openSearch() {
    if (!dlg) return;
    await ensure();
    if (!dlg.open) dlg.showModal();
    input?.focus();
    input?.select();
    render(input?.value ?? '');
  }

  document.querySelector('[data-search-open]')?.addEventListener('click', openSearch);
  input?.addEventListener('input', () => render(input.value));

  document.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement)?.tagName ?? '');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    } else if (e.key === '/' && !typing && !dlg?.open) {
      e.preventDefault();
      openSearch();
    }
  });

  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>
