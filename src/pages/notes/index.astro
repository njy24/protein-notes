---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { fmtDate, readingTime } from '../../lib/format';
import { EVIDENCE } from '../../config/site';

const notes = (await getCollection('notes', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---
<Base title="深度笔记" description="方法、失效条件与可复现路径：比速递更长、比论文更可读的拆解。">
  <div class="wrap">
    <header class="index-head">
      <p class="kicker">深度 / Notes</p>
      <h1>把一篇论文拆到可以动手</h1>
      <p class="lede" style="margin-top:1rem">
        速递回答“发生了什么”，深度回答“它是怎么做到的、在什么条件下不成立、我们能不能复现”。
        每篇都给出方法分层、失败模式与参考文献。
      </p>
      <p class="meta" style="margin-top:1.4rem">
        <span>{notes.length} 篇</span>
        <span class="meta__dot"></span>
        <span>中文为主 · 术语保留英文</span>
        <span class="meta__dot"></span>
        <span>DOI 可核验</span>
      </p>
    </header>

    <ul class="index-list" style="margin-top:1rem">
      {
        notes.map((n, i) => (
          <li>
            <a class="index-row" href={url(`/notes/${n.id}/`)}>
              <span class="index-row__date">{fmtDate(n.data.date, 'short')}</span>
              <span>
                <span class="index-row__title">{n.data.title}</span>
                <span class="index-row__desc">{n.data.summary}</span>
              </span>
              <span class="index-row__meta">
                {String(notes.length - i).padStart(2, '0')} · {readingTime(n.body ?? '')} MIN
                <br />
                {EVIDENCE[n.data.evidence].label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
